# Stage 1: Build Spring Boot JAR
FROM maven:3.9-eclipse-temurin-21-alpine AS java-builder
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -q -DskipTests package

# Stage 2: Build Unikraft unikernel & initramfs CPIO
FROM alpine:3.20 AS artifacts
RUN apk add --no-cache curl tar cpio ca-certificates bash openjdk21-jre

# 1. Install KraftKit CLI
RUN curl -sL https://github.com/unikraft/kraftkit/releases/download/v0.12.16/kraft_0.12.16_linux_amd64.tar.gz | tar -xz -C /usr/local/bin kraft && chmod +x /usr/local/bin/kraft

# 2. Pull Unikraft base binary compatibility runtime for Firecracker
RUN kraft pkg pull unikraft.org/base:latest --plat fc --arch x86_64 || kraft pkg pull unikraft.org/base:latest --plat qemu --arch x86_64

# 3. Locate the pulled Firecracker unikernel binary and stage it
RUN mkdir -p /output && \
    KERNEL_BIN=$(find /root/.local/share/kraftkit/ -type f -name "kernel" -not -name "*.dbg" | head -n 1) && \
    if [ -z "$KERNEL_BIN" ]; then KERNEL_BIN=$(find /root -type f -name "kernel" -not -name "*.dbg" | head -n 1); fi && \
    cp "$KERNEL_BIN" /output/unikernel && \
    chmod +x /output/unikernel

# 4. Prepare rootfs containing JRE + application JAR
RUN mkdir -p /rootfs/app /rootfs/usr /rootfs/lib /rootfs/etc /rootfs/tmp /rootfs/bin /rootfs/sbin /rootfs/dev /rootfs/proc /rootfs/sys
COPY --from=java-builder /build/target/bench-spring-unikraft.jar /rootfs/app.jar
RUN cp -a /bin /lib /sbin /usr /etc /rootfs/ 2>/dev/null || true

# 5. Pack rootfs into CPIO archive
RUN cd /rootfs && find . -print0 | cpio --null --create --format=newc > /output/initramfs-x86_64.cpio

# Stage 3: Scratch export image
FROM scratch
COPY --from=artifacts /output/unikernel /unikernel
COPY --from=artifacts /output/initramfs-x86_64.cpio /initramfs-x86_64.cpio
